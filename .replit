externalPort = 5173

[[ports]]
localPort = 9992
externalPort = 6000

[[ports]]
localPort = 9993
externalPort = 6800

[[ports]]
localPort = 9994
externalPort = 8000

[[ports]]
localPort = 9998
externalPort = 5000

[[ports]]
localPort = 20518
externalPort = 3000

[[ports]]
localPort = 21064
externalPort = 3002

